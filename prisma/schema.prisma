// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String         @id @default(uuid())
  email        String         @unique
  username     String         @unique
  boards       Board[] 
  messages     Message[] // Messages created by the user
  password     String?
  salt         String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  isVerified   Boolean?       @default(false)
  OAuthAccount OAuthAccount[]
  avatar String?
}

model Board {
  id          String   @id @default(uuid())  // This is enough for unique Board ID.
  name        String
  description String
  category    String
  mode        String
  status      String   @default("active")
  expiresAt   DateTime?
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages    Message[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}



model Message {
  id        String   @id @default(uuid())
  boardId   String   // changed to String
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  content   String
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


enum OAuthProvider {
  google
  github
}

model OAuthAccount {
  provider          OAuthProvider
  providerAccountId String
  userId            String
  username          String?      // ✅ Optional: store GitHub/Google username

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  avatar            String?       
  @@id([provider, providerAccountId]) // composite primary key
  @@unique([provider, providerAccountId])
}
